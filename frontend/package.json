{
  "name": "gbshadowplay-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "皮影戏排演编排台 - 纯前端 SPA（React + TypeScript + Ant Design + Vite + Zustand + React Router）",
  "scripts": {
    "dev": "vite --host --port 21802",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host --port 21802",
    "typecheck": "tsc --noEmit",
    "test:tour": "esbuild test/tour.test.ts --bundle --platform=node --format=esm --outfile=.tmp-test.mjs --external:fake-indexeddb --log-level=warning && node .tmp-test.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "dexie": "^4.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
